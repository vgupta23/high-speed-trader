# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real account numbers, keys, or tokens.

# Required: your Robinhood account number (ask Claude "list my robinhood
# accounts" once the MCP is authorized).
# MCP bridge configuration. Claude Code is the only currently supported client.
MCP_CLIENT=claude
MCP_CLIENT_BIN=claude
MCP_SERVER=robinhood
MCP_CLIENT_TIMEOUT_SEC=240

ROBINHOOD_ACCOUNT_NUMBER=12345

# Only needed if CONFIG["pick_provider"] = "openai" in high_speed_trader.py.
OPENAI_API_KEY=MY_OPENAI_API_KEY
# Optional: OpenAI model for the pick. Leave blank to use the script's
# default (CONFIG["openai_model"]).
OPENAI_MODEL=

# Optional: push trade/notify messages to Telegram. Leave blank to just log
# locally instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
